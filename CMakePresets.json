{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "installDir": "${sourceDir}/install",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "LLVM_DIR": "/home/rhanqtl/projects/circt/llvm/build/lib/cmake/llvm",
                "MLIR_DIR": "/home/rhanqtl/projects/circt/llvm/build/lib/cmake/mlir",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "base-clang",
            "hidden": true,
            "inherits": [
                "base"
            ]
        },
        {
            "name": "linux-amd64-debug",
            "binaryDir": "${sourceDir}/build/Debug",
            "inherits": [
                "base-clang"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-amd64-release",
            "binaryDir": "${sourceDir}/build/Release",
            "inherits": [
                "base-clang"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-amd64-debug",
            "configurePreset": "linux-amd64-debug",
            "jobs": 10,
            "targets": [
                "install"
            ]
        },
        {
            "name": "linux-amd64-release",
            "configurePreset": "linux-amd64-release",
            "jobs": 10,
            "targets": [
                "install"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "linux-amd64-debug",
            "configurePreset": "linux-amd64-debug"
        },
        {
            "name": "linux-amd64-release",
            "configurePreset": "linux-amd64-release"
        }
    ]
}
